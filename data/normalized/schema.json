{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Security News Item",
  "type": "object",
  "required": [
    "id",
    "product_slug",
    "product",
    "category",
    "source_id",
    "source_type",
    "source_name",
    "title",
    "summary_no",
    "impact_level",
    "impact_no",
    "published_at",
    "effective_at",
    "deadline_at",
    "date_precision",
    "estimated_date",
    "month",
    "month_label",
    "release_stage",
    "theme_tags",
    "platforms",
    "priority_score",
    "normalization_warnings",
    "url"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "product_slug": { "type": "string" },
    "product": { "type": "string" },
    "category": { "type": "string" },
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string" },
    "source_name": { "type": "string" },
    "title": { "type": "string", "minLength": 12 },
    "summary_no": { "type": "string" },
    "impact_level": { "enum": ["Høy", "Middels", "Lav"] },
    "impact_no": { "type": "string" },
    "published_at": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effective_at": { "type": ["string", "null"], "format": "date" },
    "deadline_at": { "type": ["string", "null"], "format": "date" },
    "date_precision": { "enum": ["day", "month"] },
    "estimated_date": { "type": "boolean" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "month_label": { "type": "string" },
    "release_stage": { "type": "string" },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "theme_tags": { "type": "array", "items": { "type": "string" } },
    "priority_score": { "type": "number" },
    "normalization_warnings": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false
}
