{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Security News Item",
  "type": "object",
  "required": [
    "id",
    "product_slug",
    "product",
    "category",
    "source_type",
    "source_name",
    "title",
    "summary_no",
    "impact_no",
    "published_at",
    "first_seen_at",
    "updated_at",
    "source_fetched_at",
    "date_precision",
    "release_stage_confidence",
    "impact_confidence",
    "month",
    "month_label",
    "release_stage",
    "theme_tags",
    "url"
  ],
  "properties": {
    "id": { "type": "string" },
    "product_slug": { "type": "string" },
    "product": { "type": "string" },
    "category": { "type": "string" },
    "source_type": { "type": "string" },
    "source_name": { "type": "string" },
    "title": { "type": "string" },
    "summary_no": { "type": "string" },
    "impact_no": { "type": "string" },
    "published_at": { "type": "string" },
    "first_seen_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_fetched_at": { "type": "string", "format": "date-time" },
    "date_precision": { "enum": ["day", "month"] },
    "release_stage_confidence": { "enum": ["verified", "inferred"] },
    "impact_confidence": { "enum": ["verified", "inferred"] },
    "content_fingerprint": { "type": "string" },
    "month": { "type": "string" },
    "month_label": { "type": "string" },
    "release_stage": { "type": "string" },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "theme_tags": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string" }
  }
}
